# Copy to .env for local tooling only. Vercel and other hosts take these as environment variables.

NODE_ENV=production
PORT=3000

# Required in production: Neon POOLED connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Required in production: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string

BRAND_NAME=UC Topup
CURRENCY=USD
PG_POOL_MAX=3

# Leave PAYMENT_MODE as "gateway" and DELIVERY_MODE unset until a real payment provider and UC supplier are wired in.
# PAYMENT_MODE=gateway
# DELIVERY_MODE=
